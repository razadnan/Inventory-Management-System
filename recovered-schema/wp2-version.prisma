generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  USER
}

enum MovementType {
  STOCK_IN
  STOCK_OUT
  CHALLAN_OUT
}

enum BusinessRole {
  OWNER
  ADMIN
  ACCOUNTANT
  SALES
  PURCHASE
  INVENTORY
  AUDITOR
}

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  INCOME
  EXPENSE
}

enum CashFlowClass {
  OPERATING
  INVESTING
  FINANCING
  CASH
}

enum JournalStatus {
  DRAFT
  POSTED
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole @default(USER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  stockMovements  StockMovement[]
  challans        Challan[]
  memberships     Membership[]
  journalsCreated JournalEntry[]  @relation("JournalCreatedBy")
  journalsPosted  JournalEntry[]  @relation("JournalPostedBy")
  auditLogs       AuditLog[]

  @@map("users")
}

model Product {
  id           String   @id @default(cuid())
  productCode  String   @unique
  name         String
  sku          String   @unique
  category     String?
  unitPrice    Decimal  @db.Decimal(12, 2)
  quantity     Int      @default(0)
  minimumStock Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  stockMovements StockMovement[]
  challanItems   ChallanItem[]

  @@index([name])
  @@index([category])
  @@map("products")
}

model StockMovement {
  id               String       @id @default(cuid())
  productId        String
  movementType     MovementType
  quantity         Int
  previousQuantity Int
  newQuantity      Int
  reference        String?
  userId           String
  createdAt        DateTime     @default(now())

  product Product @relation(fields: [productId], references: [id])
  user    User    @relation(fields: [userId], references: [id])

  @@index([productId])
  @@index([userId])
  @@index([createdAt])
  @@map("stock_movements")
}

model Challan {
  id            String   @id @default(cuid())
  challanNumber String   @unique
  receiverName  String
  destination   String
  remarks       String?
  createdBy     String
  createdAt     DateTime @default(now())

  creator User          @relation(fields: [createdBy], references: [id])
  items   ChallanItem[]

  @@index([createdBy])
  @@index([createdAt])
  @@map("challans")
}

model ChallanItem {
  id        String @id @default(cuid())
  challanId String
  productId String
  quantity  Int

  challan Challan @relation(fields: [challanId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@unique([challanId, productId])
  @@index([productId])
  @@map("challan_items")
}

// ---------------------------------------------------------------------------
// Accounting foundation (tenant-aware). Every table carries businessId.
// ---------------------------------------------------------------------------

model Business {
  id                      String    @id @default(cuid())
  name                    String
  legalName               String?
  gstin                   String?
  stateCode               String?
  financialYearStartMonth Int       @default(4)
  booksLockedUntil        DateTime? @db.Date
  isActive                Boolean   @default(true)
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  memberships        Membership[]
  financialYears     FinancialYear[]
  accounts           Account[]
  journalEntries     JournalEntry[]
  journalLines       JournalLine[]
  documentSequences  DocumentSequence[]
  auditLogs          AuditLog[]
  idempotencyRecords IdempotencyRecord[]

  @@map("businesses")
}

model Membership {
  id         String       @id @default(cuid())
  businessId String
  userId     String
  role       BusinessRole
  createdAt  DateTime     @default(now())

  business Business @relation(fields: [businessId], references: [id])
  user     User     @relation(fields: [userId], references: [id])

  @@unique([businessId, userId])
  @@index([userId])
  @@map("memberships")
}

model FinancialYear {
  id         String   @id @default(cuid())
  businessId String
  label      String
  startDate  DateTime @db.Date
  endDate    DateTime @db.Date
  isClosed   Boolean  @default(false)
  createdAt  DateTime @default(now())

  business Business @relation(fields: [businessId], references: [id])

  @@unique([businessId, label])
  @@map("financial_years")
}

model Account {
  id            String         @id @default(cuid())
  businessId    String
  code          String
  name          String
  type          AccountType
  parentId      String?
  isGroup       Boolean        @default(false)
  isSystem      Boolean        @default(false)
  cashFlowClass CashFlowClass?
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  business     Business      @relation(fields: [businessId], references: [id])
  parent       Account?      @relation("AccountTree", fields: [parentId], references: [id])
  children     Account[]     @relation("AccountTree")
  journalLines JournalLine[]

  @@unique([businessId, code])
  @@index([businessId, type])
  @@map("accounts")
}

model JournalEntry {
  id           String        @id @default(cuid())
  businessId   String
  entryNumber  String?
  entryDate    DateTime      @db.Date
  narration    String?
  status       JournalStatus @default(DRAFT)
  sourceType   String?
  sourceId     String?
  reversalOfId String?       @unique
  createdById  String
  postedById   String?
  postedAt     DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  business   Business      @relation(fields: [businessId], references: [id])
  createdBy  User          @relation("JournalCreatedBy", fields: [createdById], references: [id])
  postedBy   User?         @relation("JournalPostedBy", fields: [postedById], references: [id])
  reversalOf JournalEntry? @relation("JournalReversal", fields: [reversalOfId], references: [id])
  reversedBy JournalEntry? @relation("JournalReversal")
  lines      JournalLine[]

  @@unique([businessId, entryNumber])
  @@index([businessId, entryDate])
  @@index([businessId, status])
  @@index([sourceType, sourceId])
  @@map("journal_entries")
}

model JournalLine {
  id             String   @id @default(cuid())
  businessId     String
  journalEntryId String
  accountId      String
  lineNo         Int
  debit          Decimal  @default(0) @db.Decimal(18, 2)
  credit         Decimal  @default(0) @db.Decimal(18, 2)
  description    String?
  createdAt      DateTime @default(now())

  business     Business     @relation(fields: [businessId], references: [id])
  journalEntry JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  account      Account      @relation(fields: [accountId], references: [id])

  @@unique([journalEntryId, lineNo])
  @@index([businessId, accountId])
  @@map("journal_lines")
}

model DocumentSequence {
  id         String   @id @default(cuid())
  businessId String
  seriesKey  String
  fiscalYear String
  prefix     String
  nextNumber Int      @default(1)
  updatedAt  DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id])

  @@unique([businessId, seriesKey, fiscalYear])
  @@map("document_sequences")
}

model AuditLog {
  id         String   @id @default(cuid())
  businessId String?
  userId     String?
  action     String
  entityType String
  entityId   String?
  before     Json?
  after      Json?
  createdAt  DateTime @default(now())

  business Business? @relation(fields: [businessId], references: [id])
  user     User?     @relation(fields: [userId], references: [id])

  @@index([businessId, createdAt])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

model IdempotencyRecord {
  id             String   @id @default(cuid())
  businessId     String
  key            String
  endpoint       String
  requestHash    String?
  responseStatus Int?
  responseBody   Json?
  createdAt      DateTime @default(now())

  business Business @relation(fields: [businessId], references: [id])

  @@unique([businessId, key, endpoint])
  @@map("idempotency_records")
}
