generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  USER
}

enum MovementType {
  STOCK_IN
  STOCK_OUT
  CHALLAN_OUT
}

enum OrgStatus {
  ACTIVE
  INACTIVE
}

enum ProductSource {
  PURCHASED
  MANUFACTURED
}

model Organization {
  id        String    @id @default(cuid())
  name      String
  address   String?
  email     String?
  phone     String?
  userLimit Int       @default(10)
  status    OrgStatus @default(ACTIVE)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  users          User[]
  products       Product[]
  stockMovements StockMovement[]
  challans       Challan[]
  customers      Customer[]

  @@map("organizations")
}

model User {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  email          String
  passwordHash   String
  role           UserRole @default(USER)
  status         String   @default("ACTIVE")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization   Organization    @relation(fields: [organizationId], references: [id])
  stockMovements StockMovement[]
  challans       Challan[]

  @@unique([organizationId, email])
  @@index([organizationId])
  @@map("users")
}

model Product {
  id             String        @id @default(cuid())
  organizationId String
  productCode    String
  name           String
  sku            String
  category       String?
  source         ProductSource @default(PURCHASED)
  vendorName     String?
  quantity       Int           @default(0)
  minimumStock   Int           @default(0)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organization   Organization    @relation(fields: [organizationId], references: [id])
  stockMovements StockMovement[]
  challanItems   ChallanItem[]

  @@unique([organizationId, sku])
  @@unique([organizationId, productCode])
  @@index([organizationId])
  @@index([name])
  @@index([category])
  @@index([vendorName])
  @@map("products")
}

model StockMovement {
  id               String       @id @default(cuid())
  organizationId   String
  productId        String
  movementType     MovementType
  quantity         Int
  previousQuantity Int
  newQuantity      Int
  reference        String?
  userId           String
  createdAt        DateTime     @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  product      Product      @relation(fields: [productId], references: [id])
  user         User         @relation(fields: [userId], references: [id])

  @@index([organizationId])
  @@index([productId])
  @@index([userId])
  @@index([createdAt])
  @@map("stock_movements")
}

model Customer {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  contactPerson  String?
  phone          String?
  email          String?
  address        String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  challans     Challan[]

  @@index([organizationId])
  @@index([name])
  @@map("customers")
}

model Challan {
  id             String   @id @default(cuid())
  organizationId String
  challanNumber  String
  customerId     String
  destination    String?
  remarks        String?
  createdBy      String
  createdAt      DateTime @default(now())

  organization Organization     @relation(fields: [organizationId], references: [id])
  customer     Customer         @relation(fields: [customerId], references: [id])
  creator      User             @relation(fields: [createdBy], references: [id])
  items        ChallanItem[]
  services     ChallanService[]

  @@unique([organizationId, challanNumber])
  @@index([organizationId])
  @@index([customerId])
  @@index([createdBy])
  @@index([createdAt])
  @@map("challans")
}

model ChallanItem {
  id          String  @id @default(cuid())
  challanId   String
  productId   String
  quantity    Int
  unitPrice   Decimal @db.Decimal(12, 2)
  description String?

  challan Challan @relation(fields: [challanId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@unique([challanId, productId])
  @@index([productId])
  @@map("challan_items")
}

model ChallanService {
  id          String  @id @default(cuid())
  challanId   String
  description String
  amount      Decimal @db.Decimal(12, 2)

  challan Challan @relation(fields: [challanId], references: [id], onDelete: Cascade)

  @@index([challanId])
  @@map("challan_services")
}
